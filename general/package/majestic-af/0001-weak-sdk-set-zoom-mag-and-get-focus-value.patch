+/* Fallback definitions for symbols that newer majestic cores export but older
+   ones do not. musl ld.so does not honor weak undefined symbols at dlopen, so
+   we provide weak defs here that get overridden by the core when present. */
+#include <stdbool.h>
+__attribute__((weak)) void sdk_set_zoom_mag(float m) { (void)m; }
+__attribute__((weak)) bool sdk_get_focus_value(unsigned *fv) { (void)fv; return false; }
